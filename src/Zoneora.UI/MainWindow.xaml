<Window x:Class="Zoneora.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Zoneora" Height="540" Width="760" Icon="Assets/icon.ico" Background="Transparent" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Background="#F2101518" BorderBrush="#405057" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ZONEORA" Foreground="#B8F36B" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Desktop control" Foreground="#F2F4EE" FontSize="28" FontWeight="Light" Margin="0,5,0,18" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="–" Width="30" Height="30" Click="OnMinimizeClick" Background="Transparent" Foreground="#91A09E" BorderThickness="0" FontSize="18" />
                    <Button Content="×" Width="30" Height="30" Click="OnCloseClick" Background="Transparent" Foreground="#91A09E" BorderThickness="0" FontSize="20" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                <Button x:Name="DesktopViewButton" Content="Desktop" Click="OnDesktopViewClick" Padding="16,8" Background="#B8F36B" Foreground="#101518" BorderThickness="0" />
                <Button x:Name="SettingsViewButton" Content="Settings" Click="OnSettingsViewClick" Padding="16,8" Margin="8,0,0,0" Background="#263238" Foreground="#F2F4EE" BorderThickness="0" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid x:Name="DesktopView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Desktop zones" Foreground="#F2F4EE" FontSize="18" />
                        <TextBlock Text="Zones live in the desktop grid. Drag headers to move them. Enable Build Mode to grow a zone edge by edge." Foreground="#91A09E" TextWrapping="Wrap" Margin="0,8,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create zone" Width="120" Padding="14,8" Background="#B8F36B" Foreground="#101518" BorderThickness="0" Click="OnCreateZoneClick" />
                            <ToggleButton x:Name="BuildModeToggle" Content="Build Mode" Width="120" Padding="14,8" Margin="8,0,0,0" Background="#263238" Foreground="#F2F4EE" BorderThickness="0" Click="OnBuildModeClick" />
                        </StackPanel>
                        <TextBlock x:Name="ZoneStatus" Text="Loading zones..." Foreground="#91A09E" FontSize="12" Margin="0,12,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#141E22" BorderBrush="#2B373B" BorderThickness="1" CornerRadius="8" Margin="0,22,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Auto-hide" Foreground="#F2F4EE" FontSize="16" />
                            <TextBlock Text="Zones fade in while the mouse is over them and fade out 10 seconds after the mouse leaves." Foreground="#91A09E" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Settings" Foreground="#F2F4EE" FontSize="18" />
                        <TextBlock Text="Changes are saved automatically." Foreground="#91A09E" Margin="0,8,0,20" />
                        <CheckBox x:Name="HideDesktopIconsNowCheckBox" Content="Hide standard Windows desktop icons" Foreground="#F2F4EE" FontSize="14" Checked="OnHideDesktopIconsNowChanged" Unchecked="OnHideDesktopIconsNowChanged" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Zoneora with Windows" Foreground="#F2F4EE" FontSize="14" Margin="0,10,0,0" Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged" />
                        <CheckBox x:Name="ShowGridCheckBox" Content="Show desktop grid" Foreground="#F2F4EE" Margin="0,20,0,0" Checked="OnShowGridChanged" Unchecked="OnShowGridChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
