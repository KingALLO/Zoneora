<UserControl x:Class="Zoneora.UI.ZoneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120"
             MinHeight="90"
             AllowDrop="True"
             MouseEnter="OnZoneMouseEnter"
             MouseLeave="OnZoneMouseLeave"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <Grid>
        <!-- always alpha>0 so the layered desktop window keeps hit-testing this area even while VisualContent is faded to 0 -->
        <Rectangle Fill="#01000000" />
        <Border x:Name="VisualContent" Background="#E8172024" BorderBrush="#66818B" BorderThickness="1" CornerRadius="10" Padding="1">
        <Grid MouseLeftButtonDown="OnZoneMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="TitleBorder" Background="#F0222D31" CornerRadius="9,9,0,0" MouseLeftButtonDown="OnZoneMouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleEditor" Text="New zone" IsHitTestVisible="False" VerticalContentAlignment="Center" Foreground="#F2F4EE" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="SemiBold" KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus" />
                    <Button Grid.Column="1" Content="×" Width="24" Height="24" Click="OnCloseClick" Background="Transparent" Foreground="#91A09E" BorderThickness="0" FontSize="17" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="8" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList" AllowDrop="True" DragOver="OnItemDragOver" Drop="OnItemsListDrop">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="78" Height="78" Margin="2" Background="#142A3033" BorderThickness="0" Foreground="#F2F4EE" ToolTip="{Binding DisplayName}" Tag="{Binding}" AllowDrop="True" PreviewMouseLeftButtonDown="OnItemPreviewMouseLeftButtonDown" PreviewMouseMove="OnItemPreviewMouseMove" DragOver="OnItemDragOver" Drop="OnItemDrop">
                                <StackPanel IsHitTestVisible="False">
                                    <Image Width="30" Height="30" Source="{Binding Icon}" />
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="3,5,3,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button x:Name="GrowTopButton" Grid.RowSpan="2" Content="+" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-11,0,0" Background="#B18CFF" Foreground="#101518" BorderThickness="0" FontWeight="Bold" Visibility="Collapsed" Click="OnGrowTopClick" />
            <Button x:Name="GrowBottomButton" Grid.RowSpan="2" Content="+" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-11" Background="#B18CFF" Foreground="#101518" BorderThickness="0" FontWeight="Bold" Visibility="Collapsed" Click="OnGrowBottomClick" />
            <Button x:Name="GrowLeftButton" Grid.RowSpan="2" Content="+" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-11,0,0,0" Background="#B18CFF" Foreground="#101518" BorderThickness="0" FontWeight="Bold" Visibility="Collapsed" Click="OnGrowLeftClick" />
            <Button x:Name="GrowRightButton" Grid.RowSpan="2" Content="+" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-11,0" Background="#B18CFF" Foreground="#101518" BorderThickness="0" FontWeight="Bold" Visibility="Collapsed" Click="OnGrowRightClick" />
        </Grid>
        </Border>
    </Grid>
</UserControl>
