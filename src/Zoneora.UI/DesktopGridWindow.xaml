<Window x:Class="Zoneora.UI.DesktopGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icon.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="True">
    <Canvas x:Name="GridCanvas" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" />
</Window>
